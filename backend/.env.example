# Supabase Edge Functions require SMTP implicit TLS on port 465.
# For Gmail, use a Google App Password, not your Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=iftportal@gmail.com
SMTP_PASS=YOUR_GOOGLE_APP_PASSWORD
MAIL_FROM=FUTO IFT Portal <iftportal@gmail.com>
CLIENT_URL=http://localhost:3000
# Optional data directory; point this to a durable mounted volume in production.
PORTAL_DATA_DIR=

# Supabase backend (server-only secrets; never expose the service key to the browser).
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_POOL_SIZE=4

# Optional first administrator bootstrap; never use these example values.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=
ADMIN_NAME=
