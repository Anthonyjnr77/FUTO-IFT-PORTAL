# Gmail SMTP settings; use a Google App Password, not your Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=iftportal@gmail.com
SMTP_PASS=YOUR_GOOGLE_APP_PASSWORD
MAIL_FROM=FUTO IFT Portal <iftportal@gmail.com>
CLIENT_URL=http://localhost:3000

# PHP/MySQL migration settings; configure on the PHP host before enabling its API.
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Optional first administrator bootstrap; never use these example values.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=
ADMIN_NAME=
